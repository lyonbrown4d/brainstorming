{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.5",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "depends": [
          "libvips42t64 (>= 8.15) | libvips42 (>= 8.15)",
          "libgtk-4-1",
          "libnss3",
          "libnspr4",
          "libgbm1",
          "libasound2t64 | libasound2",
          "libcups2t64 | libcups2",
          "xdg-desktop-portal",
          "zenity"
        ]
      },
      "rpm": {
        "depends": [
          "vips >= 8.15",
          "gtk4",
          "nss",
          "nspr",
          "mesa-libgbm",
          "alsa-lib",
          "cups-libs",
          "xdg-desktop-portal",
          "zenity"
        ]
      }
    }
  }
}
