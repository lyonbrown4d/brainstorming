{
  "name": "brainstorming",
  "version": "0.2.0",
  "private": true,
  "description": "本地优先的跨平台思维导图工具，基于 React、TypeScript 与 Tauri 2 / Rust。",
  "type": "module",
  "author": "Brainstorming contributors",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyonbrown4d/brainstorming.git"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm generate:bindings && tauri dev",
    "lint": "pnpm generate:bindings && eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm generate:bindings && tsc --noEmit",
    "test": "pnpm generate:bindings && vitest run",
    "test:watch": "pnpm generate:bindings && vitest",
    "test:e2e": "wdio run wdio.conf.ts",
    "storybook": "pnpm generate:bindings && storybook dev -p 6006",
    "build-storybook": "pnpm generate:bindings && storybook build",
    "test:storybook": "pnpm generate:bindings && vitest run --config vitest.storybook.config.ts",
    "build": "pnpm generate:bindings && vite build",
    "package": "tsx scripts/build-desktop.ts",
    "package:linux": "tsx scripts/build-desktop.ts --bundles deb,rpm,appimage",
    "ci-gate": "moon run brainstorming:check",
    "moon": "moon",
    "prepare": "husky",
    "frontend:dev": "pnpm generate:bindings && vite",
    "build:desktop": "tsx scripts/build-desktop.ts",
    "tauri": "tauri",
    "dev:ios": "tauri ios dev",
    "dev:android": "tauri android dev",
    "build:ios": "tauri ios build",
    "build:android": "tauri android build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "native:vips": "tsx scripts/prepare-native-vips.ts",
    "build:e2e": "cross-env VITE_NATIVE_E2E=1 tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "devtools": "cross-env HOST=127.0.0.1 react-devtools",
    "test:canvas": "playwright test --config playwright.canvas.config.ts",
    "generate:bindings": "cross-env TAURI_CONFIG={} cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin generate-bindings"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify/react": "6.0.3",
    "@lexical/extension": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@scure/base": "2.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@tauri-apps/api": "2.12.4",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "12.12.0",
    "@xyflow/system": "0.0.83",
    "ahooks": "3.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "crc-32": "1.2.2",
    "culori": "4.0.2",
    "d3-hierarchy": "3.1.2",
    "dotenv": "18.0.8",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "flatbush": "4.6.2",
    "i18next": "26.5.5",
    "image-size": "2.0.4",
    "jspdf": "4.2.1",
    "katex": "0.19.0",
    "lexical": "0.52.0",
    "lodash-es": "4.18.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "1.61.0",
    "magic-bytes.js": "1.13.1",
    "mdast-util-from-markdown": "2.1.0",
    "motion": "14.6.0",
    "next-themes": "0.4.6",
    "openseadragon": "6.1.1",
    "perfect-freehand": "1.2.3",
    "pixi.js": "8.22.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-i18next": "17.1.2",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "roughjs": "4.6.6",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@moonrepo/cli": "2.6.3",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/culori": "4.0.1",
    "@types/d3-hierarchy": "3.1.7",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/katex": "0.16.8",
    "@types/lodash-es": "4.17.12",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-devtools": "8.0.0",
    "react-devtools-core": "8.0.0",
    "react-scan": "0.5.7",
    "sass-embedded": "^1.106.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "9.32.0",
    "zx": "8.8.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": "prettier --write"
  }
}
