{
  "name": "trelyx",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的桌面思维导图工具，基于 React Flow 与 Electron。",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Trelyx contributors",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyonbrown4d/trelyx.git"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test tests/e2e tests/desktop",
    "test:perf": "playwright test tests/performance",
    "test:desktop": "playwright test tests/desktop",
    "test:packaged": "playwright test tests/packaged",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "build": "electron-vite build",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "ci-gate": "moon run trelyx:check",
    "moon": "moon",
    "prepare": "husky",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@dagrejs/dagre": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify/react": "6.0.2",
    "@lexical/extension": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@scure/base": "2.4.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "12.12.0",
    "@zip.js/zip.js": "2.24.0",
    "ahooks": "3.10.0",
    "ai": "7.0.143",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "crc-32": "1.2.2",
    "culori": "4.0.2",
    "d3-hierarchy": "3.1.2",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "i18next": "26.4.7",
    "image-size": "2.0.4",
    "inversify": "8.2.3",
    "jspdf": "4.2.1",
    "katex": "0.19.0",
    "lexical": "0.52.0",
    "lodash-es": "4.18.1",
    "lucide-react": "1.59.0",
    "magic-bytes.js": "1.13.1",
    "mdast-util-from-markdown": "2.1.0",
    "motion": "14.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@moonrepo/cli": "^2.6.2",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/culori": "4.0.1",
    "@types/d3-hierarchy": "3.1.7",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/katex": "0.16.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/write-file-atomic": "4.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-scan": "0.5.7",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@moonrepo/cli",
      "better-sqlite3"
    ]
  }
}
