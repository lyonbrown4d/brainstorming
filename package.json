{
  "name": "trelyx",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的桌面思维导图工具，基于 React Flow 与 Electron。",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Trelyx contributors",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyonbrown4d/trelyx.git"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:perf": "playwright test tests/performance",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "build": "electron-vite build",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "ci-gate": "moon run trelyx:check",
    "moon": "moon",
    "prepare": "husky"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-hierarchy": "3.1.2",
    "dotenv": "18.0.8",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "write-file-atomic": "7.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@moonrepo/cli": "2.6.2",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "4.1.11",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-scan": "0.5.7",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@moonrepo/cli"
    ]
  }
}
